<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        Width="760" Height="760"
        MinWidth="560" MinHeight="480"
        d:DesignWidth="760" d:DesignHeight="760"
        x:Class="InscripcionEstilos.MainWindow"
        Background="{DynamicResource BrushFondo}"
        Title="Inscripción del curso">
    <!--Distribución del Grid Principal: Cabecera - Fila 0 (Auto) + Formulario (Lo que sobre) + Pie(Auto)-->
    <Grid RowDefinitions="Auto,*,Auto">
        <!--Cabecera-->
        <Border Grid.Row="0" Background="{DynamicResource BrushPrimario}" Padding="10"><!--Seleccionamos que este borde sera la primera fila(0)-->
            <StackPanel Spacing="4" >
                <ToggleSwitch x:Name="TemaSwitch" OffContent="Claro" OnContent="Oscuro" IsCheckedChanged="TemaSwitch_IsCheckedChanged"/>
                <TextBlock Text="Inscripción del curso" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextoSobrePrimario}" />
                <TextBlock Text="IES El Majuelo - Formación complementaria" FontSize="10" Foreground="{DynamicResource BrushTextoSobrePrimario}"/>   
            </StackPanel>
        
        <!--Formulario-->
        </Border>
        <!--Grid.Row en la fila 1 para estirarse al ancho disponible en esa fila (*)-->
        <!--Será ScrollViewer por si el contenido excete el espacio disponible -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BrushFondo}">
            <StackPanel x:Name="PanelFormulario" Spacing="10">
                <!--Bloque Datos personales-->
                <Border Classes="tarjeta" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="seccion" Text="Datos personales"/>
                        <!-- LOS CAMPOS DE ENTRADA CON GRID -->
                        <!--Campos de entrada-->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12" >
                            <!--Nombre-->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Watermark="Tu nombre" FontSize="12" />
                            <!--Apellidos-->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Apellidos:" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Watermark="Tu apellidos" FontSize="12"/>
                            <!--Fecha de nacimiento-->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fecha de nacimiento:" FontSize="12" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" FontSize="12"/>
                            <!--Email-->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Correo electrónico" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Watermark="nombre@correo.es" FontSize="12"/>
                        </Grid>             
                    </StackPanel>
                </Border>

                <!--Bloque Curso-->
                <Border Classes="tarjeta" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="seccion" Text="Curso"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12">
                            <!--Curso-->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Curso:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CursoComboBox" Grid.Row="0" Grid.Column="1" FontSize="12" >
                                <ComboBoxItem Content="Desarrollo de interfaces con Avalonia" IsSelected="True"/>
                                <ComboBoxItem Content="Desarrollo de aplicaciones web"/>
                                <ComboBoxItem Content="Administración de sistemas e infraestructura"/>
                            </ComboBox>
                            <!--Modalidad-->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Modalidad:" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                <RadioButton Content="Presencial" FontSize="12" IsChecked="True"/>
                                <RadioButton Content="Online" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>    
                </Border>
                
                <!--Bloque Preferencias-->
                <Border Classes="tarjeta" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="seccion" Text="Preferencias"/>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Intereses: " FontSize="12" VerticalAlignment="Center"/>    
                            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="12">
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Programación" FontSize="12" IsChecked="True"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Diseño" FontSize="12" IsChecked="True"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Bases de datos" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Redes" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Móviles" FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="Videojuegos" FontSize="12"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nivel (1 a 5): " FontSize="12" VerticalAlignment="Center"/>    
                            <!--Incluimos el Slider y su "Subtitulo" en un StackPanel para encapsularlo mejor-->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <!-- Con TickFrecuency indicamos de cuanto serán los intervalos, y con IsSnap...Enabled hacemos que sea fijo solo en esas fracciones-->
                                <Slider  Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="3"/>
                                <TextBlock Text="1 = principiante · 5 = avanzado" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Novedades: " FontSize="12" VerticalAlignment="Center"/>   
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" OffContent="NO quiero recibir novedades por correo" OnContent="Quiero recibir novedades por correo" FontSize="12" IsChecked="True"/> 
                        </Grid>
                    </StackPanel>
                </Border>
                <!--Bloque Observaciones-->
                <Border Classes="tarjeta" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="seccion" Text="Observaciones"/>
                        <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Watermark="Escribe aquí cualquier comentario..." FontSize="12"/>
                        <TextBlock Text="Máximo 500 caracteres." FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!--AMPLIACIÓN: Horario y facturación-->
                <Border Classes="tarjeta" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Classes="seccion" Text="Horario y facturación"/>
                        
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="16">
                            
                            <!--Fila 0: Horario preferido-->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horario preferido:" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            
                            <!--GRID días y franjas (5 filas x 6 columnas)-->
                            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="75,*,*,*,*,*" RowSpacing="8">
                                
                                <!--Cabeceras de días-->
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Lun" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Mar" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Mié" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Jue" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Vie" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>

                                <!--Franja Mañana-->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mañana" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" IsChecked="True"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" IsChecked="True"/>
                                <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" IsChecked="True"/>
                                <CheckBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" IsChecked="True"/>
                                <CheckBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Center" IsChecked="True"/>

                                <!--Franja Tarde-->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tarde" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="2" Grid.Column="4" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Center"/>

                                <!--Franja Noche-->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Noche" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="5" HorizontalAlignment="Center"/>

                                <!--Cualquier horario (ocupa las 6 columnas)-->
                                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Content="Cualquier horario" FontSize="12" Margin="0,4,0,0"/>
                            </Grid>

                            <!--Fila 1: Datos de facturaación (se expande ocupando las 2 columnas)-->
                            <Expander Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="Datos de facturación (opcional)" FontSize="12" FontWeight="Bold"/>
                                </Expander.Header>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" RowSpacing="12" Margin="0,10,0,4">
                                    <!--NIF / CIF-->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="NIF / CIF:" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Watermark="Ej.: 12345678A" FontSize="12"/>

                                    <!--Dirección-->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dirección:" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Watermark="Calle y número" FontSize="12"/>

                                    <!--CP y población (Grid anidado 90 - 12 - *)-->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CP y población:" FontSize="12" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="90,12,*">
                                        <TextBox Grid.Column="0" Watermark="CP" FontSize="12"/>
                                        <TextBox Grid.Column="2" Watermark="Población" FontSize="12"/>
                                    </Grid>

                                    <!--Forma de pago-->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Forma de pago:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" FontSize="12" Width="200">
                                        <ComboBoxItem Content="Tarjeta" IsSelected="True"/>
                                        <ComboBoxItem Content="Transferencia bancaria"/>
                                    </ComboBox>

                                    <!--Plazos-->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Plazos:" FontSize="12" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="1" Minimum="1" Maximum="12" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" FontSize="12"/>
                                </Grid>
                            </Expander>

                            <!--Fila 2: Resumen del importe con DockPanel-->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                    Background="{DynamicResource BrushFondo}" BorderBrush="LightGray" BorderThickness="1" Padding="12,10">
                                <DockPanel>
                                    <!--El elemento anclado a la derecha se declara primero-->
                                    <TextBlock DockPanel.Dock="Right" Text="240,00 €" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushPrimario}" VerticalAlignment="Center"/>
                                    <!--El último hijo rellena el resto del espacio-->
                                    <TextBlock Text="Importe estimado" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>    
        </ScrollViewer>

        <!--Pie de página con botones (Fila 2)-->
        <Border Grid.Row="2" Background="{DynamicResource BrushTarjeta}" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Limpiar" FontSize="12"/>
                <Button Classes="primary" Content="Enviar" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>          
</Window>
