<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="InscripcionEstilos.EtiquetaCampo">
            <!--  Se carga el diseño del GRID
            <StackPanel Spacing="4">
              <TextBlock x:Name="LblEtiqueta"/>
              <TextBox x:Name="TxtValor"/>
            </StackPanel>
            -->
            <Grid ColumnDefinitions="140,*">
              <TextBlock x:Name="LblEtiqueta" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtValor" Grid.Column="1"/>
            </Grid>
</UserControl>
