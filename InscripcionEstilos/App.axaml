<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InscripcionEstilos.App"
             RequestedThemeVariant="Light"><!--Arrancará por defecto con el tema claro-->
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

        <!-- Botón primario (clase .primary) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimario}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextoSobrePrimario}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="110"/>
        </Style>

        <!-- Todos los TextBox-->
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!--Encabezados de sección (clase .seccion) -->
        <Style Selector="TextBlock.seccion">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimario}"/>
        </Style>

        <!-- Tarjetas (clase .tarjeta) -->
        <Style Selector="Border.tarjeta">
            <Setter Property="Background" Value="{DynamicResource BrushTarjeta}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!--Para evitar el fallo hover del botón enviar-->
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPrimario}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextoSobrePrimario}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </Application.Styles>

    <!--Las paletas de los temas-->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--Tema Claro -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushPrimario" Color="#1F4E79"/>
                    <SolidColorBrush x:Key="BrushTextoSobrePrimario" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BrushFondo" Color="#F3F6FA"/>
                    <SolidColorBrush x:Key="BrushTarjeta" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BrushTexto" Color="#1F2933"/>
                </ResourceDictionary>
                <!--Tema Oscuro -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushPrimario" Color="#6CB0F0"/>
                    <SolidColorBrush x:Key="BrushTextoSobrePrimario" Color="#0F2438"/>
                    <SolidColorBrush x:Key="BrushFondo" Color="#1B1F24"/>
                    <SolidColorBrush x:Key="BrushTarjeta" Color="#262B32"/>
                    <SolidColorBrush x:Key="BrushTexto" Color="#E6EAF0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>


</Application>